# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY: Your Supabase anonymous key
VITE_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY: Required for backend operations (keep private)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# MONNIFY_API_KEY: For processing transactions via Monnify
MONNIFY_API_KEY="MK_TEST_..."
# VITE_MONNIFY_API_KEY: Public key for frontend SDK (same as MONNIFY_API_KEY but exposed to client)
VITE_MONNIFY_API_KEY="MK_TEST_..."
# MONNIFY_SECRET_KEY: Private key for authentication
MONNIFY_SECRET_KEY="your-secret-key"
# MONNIFY_CONTRACT_CODE: Your Monnify contract code
MONNIFY_CONTRACT_CODE="1234567890"
# VITE_MONNIFY_CONTRACT_CODE: Public contract code for frontend SDK
VITE_MONNIFY_CONTRACT_CODE="1234567890"
# MONNIFY_BASE_URL: https://sandbox.monnify.com or https://api.monnify.com
MONNIFY_BASE_URL="https://sandbox.monnify.com"
# MONNIFY_SOURCE_ACCOUNT: The source account number for disbursements
MONNIFY_SOURCE_ACCOUNT="your-source-account"
